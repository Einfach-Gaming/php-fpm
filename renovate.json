{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Automerge all updates once CI is green",
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "The PHP minor version is controlled by the build matrix, never bump it automatically",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["php"],
      "enabled": false
    }
  ]
}
